  case "$1" in
    qwen3.8-flash-next-iq2-mtp) echo 8008 ;;
    deepseek-v4.1-flash-q2-32k) echo 8009 ;;
    qwen3.8-27b) echo 8080 ;;
    qwen3.8-27b-fixed-v22-4) echo 8085 ;;
    qwen3.8-flash-next-iq4-xs) echo 8084 ;;
    qwen3.8-27b-mlxfast-mtp-server) echo 8083 ;;
    qwen3.6-35b-a3b) echo 8081 ;;
    deepseek-v4-flash) echo 8000 ;;
    glm-5.3-flash-q2) echo 8004 ;;
    glm-5.3-flash-q2-131k) echo 8007 ;;
    minimax-h3-standard) echo 11234 ;;
    minimax-h3-heretic) echo 11235 ;;
    muse-glimmer-30b-server) echo 8082 ;;
    *) return 1 ;;
  esac
}

api_model() {
  case "$1" in
    deepseek-v4-flash) echo deepseek-v4-flash ;;
    qwen3.8-flash-next-iq2-mtp) echo qwen3.8-flash-next ;;
    deepseek-v4.1-flash-q2-32k) echo deepseek-v4.1-flash ;;
    qwen3.8-27b) echo 'ggml-org/Qwen3.8-27B-GGUF:Q8_0' ;;
    qwen3.8-27b-fixed-v22-4) echo 'qwen3.8-27b-q8-fixed-v22.4' ;;
    qwen3.8-flash-next-iq4-xs) echo 'qwen3.8-flash-next-iq4-xs' ;;
    qwen3.8-27b-mlxfast-mtp-server) echo 'qwen3.8-27b-mlxfast-mtp-server' ;;
    qwen3.6-35b-a3b) echo 'mlx-community/Qwen3.6-35B-A3B-OptiQ-4bit' ;;
    glm-5.3-flash-q2|glm-5.3-flash-q2-131k) echo 'glm-5.3-flash' ;;
    muse-glimmer-30b-server) echo 'muse-glimmer' ;;
    *) return 1 ;;
  esac
}

context_size() {
  case "$1" in
    deepseek-v4.1-flash-q2-32k) echo 32768 ;;
    qwen3.8-27b|qwen3.8-27b-fixed-v22-4|muse-glimmer-30b-server) echo 131072 ;;
    qwen3.8-flash-next-iq4-xs|qwen3.8-flash-next-iq2-mtp) echo 32768 ;;
    qwen3.8-27b-mlxfast-mtp-server) echo 40960 ;;
    deepseek-v4-flash) echo 250000 ;;
    glm-5.3-flash-q2) echo 65536 ;;
    glm-5.3-flash-q2-131k) echo 131072 ;;
    *) return 1 ;;
  esac
}

output_size() {
  case "$1" in
    deepseek-v4.1-flash-q2-32k) echo 16384 ;;
    qwen3.8-flash-next-iq4-xs|qwen3.8-flash-next-iq2-mtp)
      echo 16384
      ;;
    qwen3.8-27b|qwen3.8-27b-fixed-v22-4|qwen3.8-27b-mlxfast-mtp-server|qwen3.6-35b-a3b|deepseek-v4-flash|glm-5.3-flash-q2|glm-5.3-flash-q2-131k|muse-glimmer-30b-server)
      echo 32768
      ;;
    *) return 1 ;;
  esac
}

endpoint() {
  local id="$1"
  local output_format="${2:-text}"
  local service_port
  local base_url
  local model_id
  local context
  local output

  [[ "$(kind "$id")" == service ]] || {
    echo "$id does not expose an OpenAI-compatible endpoint." >&2
    return 2
  }

  service_port="$(port "$id")"
  base_url="http://127.0.0.1:$service_port/v1"
  model_id="$(api_model "$id" 2>/dev/null || true)"
  context="$(context_size "$id" 2>/dev/null || true)"
  output="$(output_size "$id" 2>/dev/null || true)"

  if [[ "$output_format" == --json ]]; then
    command -v jq >/dev/null 2>&1 || {
      echo "jq is required for JSON endpoint output." >&2
      return 1
    }
    jq -n \
      --arg id "$id" \
      --arg base_url "$base_url" \
      --arg api_model "$model_id" \
      --argjson context "${context:-null}" \
      --argjson output "${output:-null}" \
      '{id: $id, base_url: $base_url, api_model: (if $api_model == "" then null else $api_model end), context: $context, output: $output}'
    return
  fi

  [[ "$output_format" == text ]] || {
    echo "Unknown endpoint output format: $output_format" >&2
    return 2
  }
  printf '%s\n' "$base_url"
}

omp_family() {
  case "$1" in
    deepseek-v4.1-flash-q2-32k) echo deepseek41-ds4 ;;
    deepseek-v4-flash) echo deepseek-ds4 ;;
    glm-5.3-flash-q2|glm-5.3-flash-q2-131k) echo glm-ds4 ;;
    qwen3.8-27b|qwen3.8-27b-fixed-v22-4|qwen3.8-flash-next-iq4-xs|qwen3.8-flash-next-iq2-mtp|qwen3.8-27b-mlxfast-mtp-server) echo qwen ;;
    *) return 1 ;;
  esac
}

write_omp_models() {
  local id="$1"
  local endpoint_json
  local base_url
  local provider_model
  local context
  local output
  local provider
  local name
  local family
  local temporary

  family="$(omp_family "$id")" || {
    echo "$id does not have an OMP compatibility preset." >&2
    return 2
  }
  endpoint_json="$(endpoint "$id" --json)"
  base_url="$(jq -er '.base_url' <<<"$endpoint_json")"
  provider_model="$(jq -r '.api_model // .id' <<<"$endpoint_json")"
  context="$(jq -er '.context' <<<"$endpoint_json")"
  output="$(jq -er '.output' <<<"$endpoint_json")"
  provider="modelctl-${id//./-}"
  name="$(label "$id")"

  mkdir -p "$OMP_AGENT_DIR"
  temporary="$(mktemp "$OMP_AGENT_DIR/models.yml.XXXXXX")"
  case "$family" in
    deepseek-ds4|deepseek41-ds4)
      # Use an explicit effort so OMP sends none during tool loops and compaction.
      jq -n \
        --arg family "$family" \
        --arg provider "$provider" \
        --arg base_url "$base_url" \
        --arg model "$provider_model" \
        --arg name "$name" \
        --argjson context "$context" \
        --argjson output "$output" \
        '{providers: {($provider): {
          baseUrl: $base_url,
          auth: "none",
          api: "openai-responses",
          models: [{
            id: $model,
            name: $name,
            reasoning: true,
            thinking: {mode: "effort", efforts: (if $family == "deepseek41-ds4" then ["minimal", "high"] else ["high"] end), defaultLevel: "high", requiresEffort: ($family != "deepseek41-ds4")},
            input: (if $family == "deepseek41-ds4" then ["text"] else ["text", "image"] end),
            imageInputDecoder: "stb",
            tokenizer: "deepseek-v3",
            supportsTools: true,
            contextWindow: $context,
            maxTokens: $output,
            cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0},
            compat: {
              supportsStore: false,
              supportsDeveloperRole: false,
              supportsReasoningEffort: true,
              reasoningEffortMap: (if $family == "deepseek41-ds4" then {minimal: "none"} else {} end),
              supportsToolChoice: false,
              supportsForcedToolChoice: false
            }
          }]
        }}}' >"$temporary"
      ;;
    glm-ds4)
      jq -n \
        --arg provider "$provider" \
        --arg base_url "$base_url" \
        --arg model "$provider_model" \
        --arg name "$name" \
        --argjson context "$context" \
        --argjson output "$output" \
        '{providers: {($provider): {
          baseUrl: $base_url,
          auth: "none",
          api: "openai-responses",
          models: [{
            id: $model,
            name: $name,
            reasoning: true,
            thinking: {mode: "effort", efforts: ["high"], defaultLevel: "high", requiresEffort: true},
            input: ["text"],
            tokenizer: "glm5",
            supportsTools: true,
            contextWindow: $context,
            maxTokens: $output,
            cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0},
            compat: {
              supportsStore: false,
              supportsDeveloperRole: false,
              supportsReasoningEffort: true,
              supportsToolChoice: false,
              supportsForcedToolChoice: false
            }
          }]
        }}}' >"$temporary"
      ;;
    qwen)
      local input='["text"]'
      case "$id" in
        qwen3.8-27b|qwen3.8-27b-fixed-v22-4|qwen3.8-flash-next-iq4-xs) input='["text", "image"]' ;;
      esac
      jq -n \
        --arg provider "$provider" \
        --arg base_url "$base_url" \
        --arg model "$provider_model" \
        --arg name "$name" \
        --argjson input "$input" \
        --argjson context "$context" \
        --argjson output "$output" \
        '{providers: {($provider): {
          baseUrl: $base_url,
          auth: "none",
          api: "openai-completions",
          models: [{
            id: $model,
            name: $name,
            reasoning: true,
            thinking: {mode: "effort", efforts: ["low", "medium", "xhigh"], defaultLevel: "medium", requiresEffort: false},
            input: $input,
            imageInputDecoder: "stb",
            tokenizer: "qwen3",
            supportsTools: true,
            contextWindow: $context,
            maxTokens: $output,
            cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0},
            compat: {
              supportsStore: false,
              supportsDeveloperRole: false,
              supportsReasoningEffort: true,
              maxTokensField: "max_tokens",
              thinkingFormat: "qwen-chat-template",
              qwenTemplateReasoningEffort: true
            }
          }]
        }}}' >"$temporary"
      ;;
  esac
  mv "$temporary" "$OMP_AGENT_DIR/models.yml"
  printf '%s/%s\n' "$provider" "$provider_model"
}

run_omp() {
  local id="$1"
  shift
  local selector
  local owned_server=false

  if [[ "$id" == deepseek-v4.1-flash-q2-32k && $# -gt 0 ]]; then
    # OMP's literal off can omit effort on side requests. minimal maps to native none.
    local args=("$@") i
    for ((i=0; i<${#args[@]}; i++)); do
      [[ "${args[$i]}" != -- ]] || break
      if [[ "${args[$i]}" == --thinking=off ]]; then
        args[$i]=--thinking=minimal
      elif [[ "${args[$i]}" == --thinking && "${args[$((i+1))]:-}" == off ]]; then
        args[$((i+1))]=minimal
      fi
    done
    set -- "${args[@]}"
  fi

  if [[ "$(omp_family "$id")" == glm-ds4 || "$id" == deepseek-v4.1-flash-q2-32k ]]; then
    export PI_EDIT_VARIANT="${PI_EDIT_VARIANT:-replace}"
  fi

  command -v omp >/dev/null 2>&1 || {
    echo "omp is required for modelctl omp." >&2
    return 1
  }
  command -v jq >/dev/null 2>&1 || {
    echo "jq is required for modelctl omp." >&2
    return 1
  }
  selector="$(write_omp_models "$id")"

  if ! healthy "$id"; then
    if service_loaded "$id" || listening "$id"; then
      echo "$id has a listener or launch service but is not healthy." >&2
      return 1
    fi
    start_model "$id" >&2
    owned_server=true
  fi

  cleanup_omp() {
    if [[ "$owned_server" == true ]]; then
      stop_model "$id" >&2 || true
    fi
  }
  trap cleanup_omp EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  set +e
  PI_CODING_AGENT_DIR="$OMP_AGENT_DIR" omp --model "$selector" "$@"
  local status=$?
  set -e
  trap - EXIT INT TERM
  cleanup_omp
  return "$status"
}

model_path() {
  case "$1" in
    qwen3.8-flash-next-iq2-mtp) echo "$QWEN38_DS4_MODEL_DIR/$QWEN38_DS4_MODEL" ;;
    deepseek-v4.1-flash-q2-32k) echo "$MODEL_HOME/gguf/deepseek/deepseek-v4.1-flash-q2/DeepSeek-V4.1-Flash-Q2.gguf" ;;
    qwen3.8-27b) echo "$MODEL_HOME/aliases/qwen3.8-27b" ;;
    qwen3.8-27b-fixed-v22-4) echo "$MODEL_HOME/aliases/qwen3.8-27b" ;;
    qwen3.8-flash-next-iq4-xs) echo "$QWEN38_FLASH_MODEL_DIR" ;;
    qwen3.8-27b-mlxfast-mtp) echo "$MODEL_HOME/mlx/qwen/qwen3.8-27b-mlxfast-mtp" ;;
    qwen3.8-27b-mlxfast-mtp-server) echo "$MODEL_HOME/mlx/qwen/qwen3.8-27b-mlxfast-mtp" ;;
    qwen3.6-35b-a3b) echo "$MODEL_HOME/aliases/qwen3.6-35b-a3b-mlx" ;;
    deepseek-v4-flash) echo "$MODEL_HOME/aliases/deepseek-v4-flash-current.gguf" ;;
    glm-5.3-flash-q2|glm-5.3-flash-q2-131k) echo "$MODEL_HOME/gguf/glm-5.3-flash-antirez/GLM-5.3-Flash-Q2.gguf" ;;
    minimax-h3-standard) echo "$MODEL_HOME/mlx/minimax-h3/standard-4bit" ;;
    minimax-h3-heretic) echo "$MODEL_HOME/mlx/minimax-h3/heretic-4bit" ;;
    minimax-h3-comfy) echo "$MODEL_HOME/diffusers/minimax/h3-comfy" ;;
    minimax-h3-bf16) echo "$MODEL_HOME/diffusers/minimax/h3-bf16-reference" ;;
    minimax-music3) echo "$MODEL_HOME/diffusers/minimax/music3" ;;
    mererun-ltx-2.3) echo "$MODEL_HOME/managed/mererun/snapshots/models/dgrauet/ltx-2.3-mlx" ;;
    mererun-qwen3-coder-next) echo "$MODEL_HOME/managed/mererun/snapshots/models/Qwen/Qwen3-Coder-Next-GGUF" ;;
    mererun-gemma-3-12b) echo "$MODEL_HOME/managed/mererun/snapshots/models/mlx-community/gemma-3-12b-it-4bit" ;;
    mererun-z-image-turbo) echo "$MODEL_HOME/managed/mererun/snapshots/models/filipstrand/Z-Image-Turbo-mflux-4bit" ;;
    muse-glimmer-30b) echo "$MODEL_HOME/llm/meta/muse-glimmer-30b-bf16" ;;
    muse-glimmer-30b-server) echo "$MODEL_HOME/gguf/meta/muse-glimmer-30b" ;;
    *) return 1 ;;
  esac
}

known_model() {
  label "$1" >/dev/null 2>&1
}

ready() {
  local id="$1"
  case "$id" in
    qwen3.8-flash-next-iq2-mtp)
      [[ -f "$(model_path "$id")" &&
        "$(/usr/bin/stat -f '%z' "$(model_path "$id")")" == 50343093376 &&
        -f "$QWEN38_DS4_MODEL_DIR/$QWEN38_DS4_PLE" &&
        "$(/usr/bin/stat -f '%z' "$QWEN38_DS4_MODEL_DIR/$QWEN38_DS4_PLE")" == 32000157440 &&
        -x "$QWEN38_DS4_ROOT/ds4-server" &&
        "$(git -C "$QWEN38_DS4_ROOT" rev-parse HEAD 2>/dev/null)" == "$QWEN38_DS4_COMMIT" ]] &&
        git -C "$QWEN38_DS4_ROOT" diff --quiet HEAD -- &&
        make -q -C "$QWEN38_DS4_ROOT" ds4-server
      ;;
    deepseek-v4.1-flash-q2-32k)
      [[ -f "$(model_path "$id")" &&
        "$(/usr/bin/stat -L -f '%z' "$(model_path "$id")")" == "$DEEPSEEK41_MODEL_BYTES" &&
        -x "$DEEPSEEK41_DS4_ROOT/ds4-server" &&
        "$(git -C "$DEEPSEEK41_DS4_ROOT" rev-parse HEAD 2>/dev/null)" == "$DEEPSEEK41_DS4_COMMIT" ]] &&
        git -C "$DEEPSEEK41_DS4_ROOT" diff --quiet HEAD -- &&
        make -q -C "$DEEPSEEK41_DS4_ROOT" ds4-server
      ;;
    qwen3.8-27b)
      [[ -f "$MODEL_HOME/aliases/qwen3.8-27b/model.gguf" && -f "$MODEL_HOME/aliases/qwen3.8-27b/mmproj.gguf" ]]
      ;;
    qwen3.8-27b-fixed-v22-4)
      [[ -f "$MODEL_HOME/aliases/qwen3.8-27b/model.gguf" &&
        -f "$MODEL_HOME/aliases/qwen3.8-27b/mmproj.gguf" &&
        -f "$QWEN_FIXED_TEMPLATE" &&
        "$(shasum -a 256 "$QWEN_FIXED_TEMPLATE" | awk '{ print $1 }')" == "$QWEN_FIXED_TEMPLATE_SHA256" &&
        -x "$(command -v llama-server 2>/dev/null)" ]]
      ;;
    qwen3.8-flash-next-iq4-xs)
      [[ -f "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_SHARD_1" &&
        "$(/usr/bin/stat -f '%z' "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_SHARD_1")" == "10946624" &&
        -f "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_SHARD_2" &&
        "$(/usr/bin/stat -f '%z' "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_SHARD_2")" == "49835229856" &&
        -f "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_SHARD_3" &&
        "$(/usr/bin/stat -f '%z' "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_SHARD_3")" == "43836407744" &&
        -f "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_MMPROJ" &&
        "$(/usr/bin/stat -f '%z' "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_MMPROJ")" == "904004000" &&
        -x "$QWEN38_FLASH_RUNTIME_ROOT/build-make/bin/llama-server" &&
        "$(git -C "$QWEN38_FLASH_RUNTIME_ROOT" rev-parse HEAD 2>/dev/null)" == "$QWEN38_FLASH_RUNTIME_COMMIT" &&
        "$("$QWEN38_FLASH_RUNTIME_ROOT/build-make/bin/llama-server" --version 2>&1 | head -n 1)" == *"commit 9723942ad"* ]] &&
        git -C "$QWEN38_FLASH_RUNTIME_ROOT" diff --quiet HEAD --
      ;;
    deepseek-v4-flash)
      [[ -f "$(model_path "$id")" &&
        "$(/usr/bin/stat -L -f '%z' "$(model_path "$id")")" == "$DEEPSEEK_MODEL_BYTES" &&
        -f "$DEEPSEEK_VISION_PATH" &&
        "$(/usr/bin/stat -f '%z' "$DEEPSEEK_VISION_PATH")" == "$DEEPSEEK_VISION_BYTES" &&
        -x "$DEEPSEEK_DS4_ROOT/ds4-server" &&
        "$(git -C "$DEEPSEEK_DS4_ROOT" rev-parse HEAD 2>/dev/null)" == "$DEEPSEEK_DS4_COMMIT" ]] &&
        git -C "$DEEPSEEK_DS4_ROOT" diff --quiet HEAD -- &&
        make -q -C "$DEEPSEEK_DS4_ROOT" ds4-server
      ;;
    glm-5.3-flash-q2|glm-5.3-flash-q2-131k)
      [[ -f "$(model_path "$id")" &&
        "$(/usr/bin/stat -f '%z' "$(model_path "$id")")" == "$GLM53_MODEL_BYTES" &&
        -x "$GLM53_DS4_ROOT/ds4-server" &&
        "$(git -C "$GLM53_DS4_ROOT" rev-parse HEAD 2>/dev/null)" == "$GLM53_DS4_COMMIT" ]] &&
        git -C "$GLM53_DS4_ROOT" diff --quiet HEAD -- &&
        make -q -C "$GLM53_DS4_ROOT" ds4-server
      ;;
    qwen3.6-35b-a3b)
      [[ -f "$MODEL_HOME/aliases/qwen3.6-35b-a3b-mlx/config.json" && -x "$MODEL_HOME/runtime/mlx-lm-venv/bin/mlx_lm.server" ]]
      ;;
    qwen3.8-27b-mlxfast-mtp)
      [[ -x "$MODEL_HOME/scripts/qwen38-mlxfast-mtp.sh" ]] &&
        "$MODEL_HOME/scripts/qwen38-mlxfast-mtp.sh" --doctor >/dev/null 2>&1
      ;;
    qwen3.8-27b-mlxfast-mtp-server)
      [[ -x "$MODEL_HOME/scripts/qwen38-mlxfast-server.sh" ]] &&
        "$MODEL_HOME/scripts/qwen38-mlxfast-server.sh" --doctor >/dev/null 2>&1
      ;;
    minimax-h3-standard|minimax-h3-heretic)
      [[ -f "$(model_path "$id")/config.json" && -x "$HOME/code/minimax-h3-mlx/runtime/mlx-serve" ]]
      ;;
    muse-glimmer-30b)
      [[ -f "$(model_path "$id")/config.json" &&
        -f "$(model_path "$id")/model.safetensors.index.json" &&
        -f "$(model_path "$id")/model-00001-of-00002.safetensors" &&
        -f "$(model_path "$id")/model-00002-of-00002.safetensors" &&
        -x "$MUSE_GLIMMER_HARNESS_VENV/bin/python" &&
        -f "$MUSE_GLIMMER_HARNESS_DIR/run_agent.py" &&
        -f "$MUSE_GLIMMER_HARNESS_DIR/response_parser.py" ]]
      ;;
    muse-glimmer-30b-server)
      [[ -f "$(model_path "$id")/Muse-Glimmer-30B-KQuant-Dynamic-Q4_K_XL.gguf" &&
        -f "$(model_path "$id")/mmproj-Muse-Glimmer-30B-Q4_K_M.gguf" &&
        -x "$(command -v llama-server 2>/dev/null)" ]]
      ;;
    *)
      [[ -e "$(model_path "$id")" ]]
      ;;
  esac
}

listening() {
  local id="$1"
  local service_port
  service_port="$(port "$id")"
  lsof -nP -iTCP:"$service_port" -sTCP:LISTEN >/dev/null 2>&1
}

healthy() {
  local id="$1"
  local service_port
  service_port="$(port "$id")"
  case "$id" in
    qwen3.8-flash-next-iq2-mtp)
      curl -fsS --max-time 2 "http://127.0.0.1:$service_port/v1/models" 2>/dev/null |
        jq -e '.data | any(.id == "qwen3.8-flash-next")' >/dev/null 2>&1
      ;;
    qwen3.8-27b)
      curl -fsS --max-time 2 "http://127.0.0.1:$service_port/health" >/dev/null 2>&1
      ;;
    glm-5.3-flash-q2|glm-5.3-flash-q2-131k)
      curl -fsS --max-time 2 "http://127.0.0.1:$service_port/v1/models" 2>/dev/null |
        jq -e '.data | any(.id == "glm-5.3-flash")' >/dev/null 2>&1
      ;;
    *)
      curl -fsS --max-time 2 "http://127.0.0.1:$service_port/v1/models" >/dev/null 2>&1
      ;;
  esac
}

service_label() {
  local id="${1//./_}"
  echo "com.fcoury.local-models.$id"
}

service_loaded() {
  launchctl print "gui/$(id -u)/$(service_label "$1")" >/dev/null 2>&1
}

service_pid() {
  launchctl print "gui/$(id -u)/$(service_label "$1")" 2>/dev/null |
    sed -n 's/^[[:space:]]*pid = \([0-9][0-9]*\)$/\1/p' |
    head -n 1
}

qwen_variant_peer() {
  case "$1" in
    qwen3.8-27b) echo qwen3.8-27b-fixed-v22-4 ;;
    qwen3.8-27b-fixed-v22-4) echo qwen3.8-27b ;;
    *) return 1 ;;
  esac
}

require_qwen_variant_peer_stopped() {
  local id="$1"
  local peer
  peer="$(qwen_variant_peer "$id" 2>/dev/null || true)"
  [[ -n "$peer" ]] || return 0
  if service_loaded "$peer" || listening "$peer"; then
    echo "$id reuses the same Qwen weights as $peer; stop $peer before starting this profile." >&2
    return 1
  fi
}

glm_variant_peer() {
  case "$1" in
    glm-5.3-flash-q2) echo glm-5.3-flash-q2-131k ;;
    glm-5.3-flash-q2-131k) echo glm-5.3-flash-q2 ;;
    *) return 1 ;;
  esac
}

require_glm_variant_peer_stopped() {
  local id="$1"
  local peer
  peer="$(glm_variant_peer "$id" 2>/dev/null || true)"
  [[ -n "$peer" ]] || return 0
  if service_loaded "$peer" || listening "$peer"; then
    echo "$id reuses the same GLM weights as $peer; stop $peer before starting this profile." >&2
    return 1
  fi
}

# V4.1 streaming consumes most of a 128 GiB host. Serialize managed models.
require_deepseek41_exclusive() {
  local id="$1" peer
  if [[ "$id" == deepseek-v4.1-flash-q2-32k ]]; then
    while IFS= read -r peer; do
      [[ "$peer" != "$id" && "$(kind "$peer")" == service ]] || continue
      if service_loaded "$peer" || listening "$peer"; then
        echo "Stop $peer before starting $id." >&2
        return 1
      fi
    done < <(models)
  elif service_loaded deepseek-v4.1-flash-q2-32k || listening deepseek-v4.1-flash-q2-32k; then
    echo "Stop deepseek-v4.1-flash-q2-32k before starting $id." >&2
    return 1
  fi
}

run_model() {
  local id="$1"
  shift
  require_deepseek41_exclusive "$id"
  case "$id" in
    qwen3.8-flash-next-iq2-mtp)
      cd "$QWEN38_DS4_ROOT"
      exec "$QWEN38_DS4_ROOT/ds4-server" \
        --metal \
        --model "$(model_path "$id")" \
        --ple "$QWEN38_DS4_MODEL_DIR/$QWEN38_DS4_PLE" \
        --ctx "$(context_size "$id")" \
        --tokens "$(output_size "$id")" \
        --prefill-chunk 1024 \
        --mtp --mtp-exact-sampling \
        --host 127.0.0.1 \
        --port "$(port "$id")"
      ;;
    deepseek-v4.1-flash-q2-32k)
      local kv_dir="$STATE_HOME/kv/$id"
      mkdir -p "$kv_dir"
      cd "$DEEPSEEK41_DS4_ROOT"
      exec "$DEEPSEEK41_DS4_ROOT/ds4-server" \
        --backend metal --ssd-streaming \
        --model "$(model_path "$id")" \
        --ctx "$(context_size "$id")" --tokens "$(output_size "$id")" \
        --host 127.0.0.1 --port "$(port "$id")" \
        --kv-disk-dir "$kv_dir" --kv-disk-space-mb 8192 "$@"
      ;;
    qwen3.8-27b)
      require_qwen_variant_peer_stopped "$id"
      exec llama-server \
        --model "$MODEL_HOME/aliases/qwen3.8-27b/model.gguf" \
        --mmproj "$MODEL_HOME/aliases/qwen3.8-27b/mmproj.gguf" \
        --alias 'ggml-org/Qwen3.8-27B-GGUF:Q8_0' \
        --gpu-layers all \
        --flash-attn on \
        --ctx-size 131072 \
        --parallel 1 \
        --host 127.0.0.1 \
        --port 8080 \
        --cors-origins localhost \
        --temp 1.0 \
        --top-p 0.95 \
        --top-k 20 \
        --min-p 0 \
        --reasoning on \
        --reasoning-preserve \
        --image-min-tokens 1024 \
        --chat-template-kwargs '{"reasoning_effort":"medium"}'
      ;;
    qwen3.8-27b-fixed-v22-4)
      require_qwen_variant_peer_stopped "$id"
      exec llama-server \
        --model "$MODEL_HOME/aliases/qwen3.8-27b/model.gguf" \
        --mmproj "$MODEL_HOME/aliases/qwen3.8-27b/mmproj.gguf" \
        --alias 'qwen3.8-27b-q8-fixed-v22.4' \
        --gpu-layers all \
        --flash-attn on \
        --ctx-size 131072 \
        --parallel 1 \
        --host 127.0.0.1 \
        --port 8085 \
        --cors-origins localhost \
        --temp 1.0 \
        --top-p 0.95 \
        --top-k 20 \
        --min-p 0 \
        --jinja \
        --chat-template-file "$QWEN_FIXED_TEMPLATE" \
        --reasoning-format deepseek \
        --reasoning-preserve \
        --image-min-tokens 1024 \
        --chat-template-kwargs '{"reasoning_effort":"medium"}'
      ;;
    qwen3.8-flash-next-iq4-xs)
      exec "$QWEN38_FLASH_RUNTIME_ROOT/build-make/bin/llama-server" \
        --model "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_SHARD_1" \
        --mmproj "$QWEN38_FLASH_MODEL_DIR/$QWEN38_FLASH_MMPROJ" \
        --alias 'qwen3.8-flash-next-iq4-xs' \
        --gpu-layers all \
        --fit off \
        --flash-attn on \
        --ctx-size 32768 \
        --parallel 1 \
        --host 127.0.0.1 \
        --port 8084 \
        --cors-origins localhost \
        --jinja \
        --temp 1.0 \
        --top-p 0.95 \
        --top-k 20 \
        --min-p 0 \
        --presence-penalty 0 \
        --repeat-penalty 1.0 \
        --reasoning on \
        --reasoning-preserve \
        --reasoning-effort medium \
        --image-min-tokens 1024
      ;;
    qwen3.6-35b-a3b)
      export HF_HOME="$MODEL_HOME/mlx/qwen/qwen3.6-35b-a3b/hf-home"
      export HF_HUB_CACHE="$HF_HOME/hub"
      exec "$MODEL_HOME/runtime/mlx-lm-venv/bin/mlx_lm.server" \
        --model 'mlx-community/Qwen3.6-35B-A3B-OptiQ-4bit' \
        --host 127.0.0.1 \
        --port 8081 \
        --max-tokens 2048 \
        --temp 0.6 \
        --top-p 0.95 \
        --chat-template-args '{"enable_thinking":false}'
      ;;
    qwen3.8-27b-mlxfast-mtp)
      exec "$MODEL_HOME/scripts/qwen38-mlxfast-mtp.sh" "$@"
      ;;
    qwen3.8-27b-mlxfast-mtp-server)
      exec "$MODEL_HOME/scripts/qwen38-mlxfast-server.sh" "$@"
      ;;
    deepseek-v4-flash)
      local ds4_kv_dir="${TMPDIR:-/tmp}/local-models-ds4-kv"
      mkdir -p "$ds4_kv_dir"
      cd "$DEEPSEEK_DS4_ROOT"
      exec "$DEEPSEEK_DS4_ROOT/ds4-server" \
        --backend metal \
        --model "$(model_path "$id")" \
        --vision "$DEEPSEEK_VISION_PATH" \
        --ctx 250000 \
        --host 127.0.0.1 \
        --port 8000 \
        --kv-disk-dir "$ds4_kv_dir" \
        --kv-disk-space-mb 8192
      ;;
    glm-5.3-flash-q2|glm-5.3-flash-q2-131k)
      require_glm_variant_peer_stopped "$id"
      local glm53_kv_dir="$STATE_HOME/kv/$id"
      mkdir -p "$glm53_kv_dir"
      cd "$GLM53_DS4_ROOT"
      exec "$GLM53_DS4_ROOT/ds4-server" \
        --backend metal \
        --model "$(model_path "$id")" \
        --ctx "$(context_size "$id")" \
        --tokens "$(output_size "$id")" \
        --host 127.0.0.1 \
        --port "$(port "$id")" \
        --kv-disk-dir "$glm53_kv_dir" \
        --kv-disk-space-mb 8192
      ;;
    minimax-h3-standard|minimax-h3-heretic)
      exec "$HOME/code/minimax-h3-mlx/runtime/mlx-serve" \
        --model "$(model_path "$id")" \
        --serve \
        --host 127.0.0.1 \
        --port "$(port "$id")" \
        --timeout 0
      ;;
    muse-glimmer-30b-server)
      exec llama-server \
        --model "$(model_path "$id")/Muse-Glimmer-30B-KQuant-Dynamic-Q4_K_XL.gguf" \
        --mmproj "$(model_path "$id")/mmproj-Muse-Glimmer-30B-Q4_K_M.gguf" \
        --alias muse-glimmer \
        --gpu-layers all \
        --flash-attn on \
        --ctx-size 131072 \
        --parallel 1 \
        --host 127.0.0.1 \
        --port 8082 \
        --jinja \
        --temp 1.0 \
        --top-p 0.95 \
        --top-k 64 \
        --chat-template-kwargs '{"reasoning_strength":"low"}'
      ;;
    muse-glimmer-30b)
      export HF_HOME="${HF_HOME:-$MODEL_HOME/cache/huggingface}"
      MUSE_GLIMMER_MODEL_PATH="$(model_path "$id")"
      export MUSE_GLIMMER_MODEL_PATH
      cd "$MUSE_GLIMMER_HARNESS_DIR"
      exec "$MUSE_GLIMMER_HARNESS_VENV/bin/python" run_agent.py "$@"
      ;;
    *)
      echo "$id is an asset collection and does not have a standalone server." >&2
      exit 2
      ;;
  esac
}

status_one() {
  local id="$1"
  local model_kind
  local state
  model_kind="$(kind "$id")"
  if [[ "$model_kind" != service ]]; then
    if ready "$id"; then
      case "$id" in
        mererun-*) state=managed ;;
        *) state=ready ;;
      esac
    else
      state=missing
    fi
    printf '%-29s %-9s %s\n' "$id" "$state" "$(model_path "$id")"
    return
  fi

  if service_loaded "$id"; then
    local pid
    pid="$(service_pid "$id")"
    if healthy "$id"; then
      state=running
    elif [[ -n "$pid" ]]; then
      state=starting
    else
      state=failed
    fi
    printf '%-29s %-9s pid=%s port=%s\n' "$id" "$state" "${pid:-unknown}" "$(port "$id")"
    return
  fi

  if listening "$id"; then
    printf '%-29s %-9s port=%s (not managed by modelctl)\n' "$id" external "$(port "$id")"
  elif ready "$id"; then
    printf '%-29s %-9s port=%s\n' "$id" stopped "$(port "$id")"
  else
    printf '%-29s %-9s %s\n' "$id" missing "$(model_path "$id")"
  fi
}

startup_timeout() {
  case "$1" in
    qwen3.8-flash-next-iq2-mtp) echo 180 ;;
    deepseek-v4.1-flash-q2-32k) echo 180 ;;
    qwen3.8-flash-next-iq4-xs) echo 900 ;;
    qwen3.8-27b-mlxfast-mtp-server) echo 600 ;;
    glm-5.3-flash-q2|glm-5.3-flash-q2-131k) echo 180 ;;
    *) echo 45 ;;
  esac
}

start_model() {
  local id="$1"
  local log_file="$LOG_DIR/$id.log"
  local launch_label
  local self

  case "$(kind "$id")" in
    harness)
      echo "$id is an interactive harness, not a model server." >&2
      echo "Run it in the foreground with: modelctl run $id [ARGS]" >&2
      exit 2
      ;;
    asset)
      echo "$id is an asset collection and cannot be started." >&2
      exit 2
      ;;
  esac
  if ! ready "$id"; then
    echo "Model or runtime is incomplete: $(model_path "$id")" >&2
    exit 1
  fi
  require_qwen_variant_peer_stopped "$id"
  require_glm_variant_peer_stopped "$id"
  require_deepseek41_exclusive "$id"
  if listening "$id"; then
    echo "$id already has a listener on port $(port "$id")."
    status_one "$id"
    return
  fi

  launch_label="$(service_label "$id")"
  if service_loaded "$id"; then
    if [[ -n "$(service_pid "$id")" ]]; then
      echo "$id already has a loaded launch service."
      status_one "$id"
      return
    fi
    launchctl remove "$launch_label" >/dev/null 2>&1 || true
  fi

  self="$(command -v modelctl 2>/dev/null || true)"
  if [[ -z "$self" ]]; then self="$0"; fi
  if [[ "$self" != /* ]]; then self="$PWD/$self"; fi

  launchctl submit \
    -l "$launch_label" \
    -o "$log_file" \
    -e "$log_file" \
    -- /usr/bin/env \
      "MODEL_HOME=$MODEL_HOME" \
      "LOCAL_MODEL_STATE_HOME=$STATE_HOME" \
      "DEEPSEEK_DS4_ROOT=$DEEPSEEK_DS4_ROOT" \
      "DEEPSEEK41_DS4_ROOT=$DEEPSEEK41_DS4_ROOT" \
      "GLM53_DS4_ROOT=$GLM53_DS4_ROOT" \
      "QWEN38_FLASH_RUNTIME_ROOT=$QWEN38_FLASH_RUNTIME_ROOT" \
      "QWEN38_DS4_ROOT=$QWEN38_DS4_ROOT" \
      "PATH=$PATH" \
      "$self" __run "$id"

  local empty_pid_checks=0
  for _ in $(seq 1 "$(startup_timeout "$id")"); do
    if healthy "$id"; then
      echo "Started $id on http://127.0.0.1:$(port "$id") (PID $(service_pid "$id"))"
      echo "Log: $log_file"
      return
    fi
    if ! service_loaded "$id"; then
      echo "$id exited during startup. Recent log output:" >&2
      tail -40 "$log_file" >&2 || true
      exit 1
    fi
    if [[ -z "$(service_pid "$id")" ]]; then
      empty_pid_checks=$((empty_pid_checks + 1))
      if (( empty_pid_checks >= 5 )); then
        launchctl remove "$launch_label" >/dev/null 2>&1 || true
        echo "$id exited during startup. Recent log output:" >&2
        tail -40 "$log_file" >&2 || true
        exit 1
      fi
    else
      empty_pid_checks=0
    fi
    sleep 1
  done

  echo "$id is still starting in the background (PID $(service_pid "$id"))."
  echo "Check with: modelctl status $id"
  echo "Log: $log_file"
}

stop_model() {
  local id="$1"
  local launch_label
  launch_label="$(service_label "$id")"

  if ! service_loaded "$id"; then
    if listening "$id"; then
      echo "$id is running outside modelctl; refusing to stop an unmanaged process." >&2
      exit 1
    fi
    echo "$id is not running."
    return
  fi

  launchctl remove "$launch_label"
  for _ in $(seq 1 15); do
    if ! service_loaded "$id" && ! listening "$id"; then
      echo "Stopped $id."
      return
    fi
    sleep 1
  done

  echo "$id did not stop after 15 seconds." >&2
  exit 1
}

doctor() {
  local requested_id="${1:-}"
  local failures=0

  if [[ -n "$requested_id" ]]; then
    known_model "$requested_id" || { echo "Unknown model: $requested_id" >&2; return 2; }
    if ! ready "$requested_id"; then
      echo "missing $requested_id -> $(model_path "$requested_id")"
      return 1
    fi
    if [[ "$requested_id" == qwen3.8-flash-next-iq2-mtp ]]; then
      local model_hash ple_hash
      model_hash="$(openssl dgst -sha256 "$(model_path "$requested_id")" | awk '{print $NF}')"
      ple_hash="$(openssl dgst -sha256 "$QWEN38_DS4_MODEL_DIR/$QWEN38_DS4_PLE" | awk '{print $NF}')"
      [[ "$model_hash" == 31f1e193771a5f3fdaa7af5865e0417513e8e8cac37579d388052ca54c889d4b &&
        "$ple_hash" == 66db3ab390f4dd5063ecc89cc180f4713898577682347001bf64ab8e328527a1 ]] || {
        echo "Qwen3.8 DwarfStar model or PLE SHA-256 mismatch." >&2
        return 1
      }
    fi
    if [[ "$requested_id" == muse-glimmer-30b ]]; then
      if ! "$MUSE_GLIMMER_HARNESS_VENV/bin/python" \
        "$MUSE_GLIMMER_HARNESS_DIR/response_parser.py"; then
        echo "Muse Glimmer parser checks failed." >&2
        return 1
      fi
    fi
    if [[ "$requested_id" == glm-5.3-flash-q2 || "$requested_id" == glm-5.3-flash-q2-131k ]]; then
      local actual_sha256
      actual_sha256="$(shasum -a 256 "$(model_path "$requested_id")" | awk '{ print $1 }')"
      if [[ "$actual_sha256" != "$GLM53_MODEL_SHA256" ]]; then
        echo "GLM 5.3 model SHA-256 mismatch: $actual_sha256" >&2
        return 1
      fi
    fi
    if [[ "$requested_id" == deepseek-v4.1-flash-q2-32k ]]; then
      local actual_sha256
      actual_sha256="$(openssl dgst -sha256 "$(model_path "$requested_id")" | awk '{print $NF}')"
      if [[ "$actual_sha256" != "$DEEPSEEK41_MODEL_SHA256" ]]; then
        echo "DeepSeek V4.1 model SHA-256 mismatch: $actual_sha256" >&2
        return 1
      fi
    fi
    if [[ "$requested_id" == deepseek-v4-flash ]]; then
      local deepseek_model_sha256
      local deepseek_vision_sha256
      deepseek_model_sha256="$(shasum -a 256 "$(model_path "$requested_id")" | awk '{ print $1 }')"
      deepseek_vision_sha256="$(shasum -a 256 "$DEEPSEEK_VISION_PATH" | awk '{ print $1 }')"
      if [[ "$deepseek_model_sha256" != "$DEEPSEEK_MODEL_SHA256" ]]; then
        echo "DeepSeek Vision-Exp model SHA-256 mismatch: $deepseek_model_sha256" >&2
        return 1
      fi
      if [[ "$deepseek_vision_sha256" != "$DEEPSEEK_VISION_SHA256" ]]; then
        echo "DeepSeek Vision-Exp encoder SHA-256 mismatch: $deepseek_vision_sha256" >&2
        return 1
      fi
    fi
    if [[ "$requested_id" == qwen3.8-flash-next-iq4-xs ]]; then
      local qwen38_flash_checksums
      qwen38_flash_checksums="$(
        cd "$QWEN38_FLASH_MODEL_DIR"
        /usr/bin/shasum -a 256 \
          "$QWEN38_FLASH_SHARD_1" \
          "$QWEN38_FLASH_SHARD_2" \
          "$QWEN38_FLASH_SHARD_3" \
          "$QWEN38_FLASH_MMPROJ"
      )"
      grep -q '^5ce89370720f8bf90890f439361282104c1aa1482d4013bb9a50923e758e71a4 ' <<<"$qwen38_flash_checksums" || {
        echo "Qwen3.8 Flash Next shard 1 SHA-256 mismatch." >&2
        return 1
      }
      grep -q '^577a38a2392b40ca2193cea502e1d92f60b8cd370675d308e0ec21885d9daaa7 ' <<<"$qwen38_flash_checksums" || {
        echo "Qwen3.8 Flash Next shard 2 SHA-256 mismatch." >&2
        return 1
      }
      grep -q '^d4634e6d84f0ebb0940be15c90d3790bf6464e3dea3a1cddc567dc0e83ad8833 ' <<<"$qwen38_flash_checksums" || {
        echo "Qwen3.8 Flash Next shard 3 SHA-256 mismatch." >&2
        return 1
      }
      grep -q '^1f7b7f0b984cf065c604360c29c8098362ed61b290db0ff12c6f360bb1a8a980 ' <<<"$qwen38_flash_checksums" || {
        echo "Qwen3.8 Flash Next vision projector SHA-256 mismatch." >&2
        return 1
      }
    fi
    echo "All checks passed for $requested_id."
    return
  fi

  for command_name in curl lsof shasum; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      echo "missing command: $command_name"
      failures=$((failures + 1))
    fi
  done
  if ! command -v llama-server >/dev/null 2>&1; then
    echo "missing command: llama-server"
    failures=$((failures + 1))
  fi

  while IFS= read -r id; do
    if ready "$id"; then
      echo "ok      $id"
    else
      echo "missing $id -> $(model_path "$id")"
      failures=$((failures + 1))
    fi
  done < <(models)

  if (( failures > 0 )); then
    echo "$failures check(s) failed." >&2
    exit 1
  fi
  echo "All model checks passed."
}

usage() {
  cat <<'EOF'
Usage: modelctl COMMAND [MODEL]

Commands:
  list                 Show all installed model services and assets
  status [MODEL]       Show all statuses, or one model's status
  start MODEL          Start a model server in the background
  run MODEL [ARGS]     Run a model server or interactive harness in the foreground
  stop MODEL           Stop a server started by modelctl
  logs MODEL           Follow a model server log
  path MODEL           Print the canonical model path
  endpoint MODEL [--json]
                       Print the OpenAI-compatible endpoint metadata
  omp MODEL [OMP_ARGS]
                       Run OMP with generated model metadata; owns server lifecycle when needed
  doctor [MODEL]       Validate all models, or one model and its runtime
EOF
}

command_name="${1:-}"
case "$command_name" in
  list)
    printf '%-29s %-9s %s\n' MODEL STATUS LOCATION
    while IFS= read -r id; do status_one "$id"; done < <(models)
    ;;
  status)
    if [[ -n "${2:-}" ]]; then
      known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
      status_one "$2"
    else
      while IFS= read -r id; do status_one "$id"; done < <(models)
    fi
    ;;
  start)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
    start_model "$2"
    ;;
  run)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
    id="$2"
    shift 2
    if [[ "$id" != qwen3.8-27b-mlxfast-mtp-server || "${1:-}" != --build ]]; then
      ready "$id" || { echo "Model or runtime is incomplete: $(model_path "$id")" >&2; exit 1; }
    fi
    run_model "$id" "$@"
    ;;
  stop)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
    [[ "$(kind "$2")" == service ]] || { echo "$2 is not a model server." >&2; exit 2; }
    stop_model "$2"
    ;;
  logs)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
    [[ "$(kind "$2")" == service ]] || { echo "$2 is not a model server and has no managed log." >&2; exit 2; }
    touch "$LOG_DIR/$2.log"
    exec tail -f "$LOG_DIR/$2.log"
    ;;
  path)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
    model_path "$2"
    ;;
  endpoint)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
    endpoint "$2" "${3:-text}"
    ;;
  omp)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    known_model "$2" || { echo "Unknown model: $2" >&2; exit 2; }
    [[ "$(kind "$2")" == service ]] || { echo "$2 is not a model server." >&2; exit 2; }
    id="$2"
    shift 2
    run_omp "$id" "$@"
    ;;
  doctor)
    doctor "${2:-}"
    ;;
  __run)
    [[ -n "${2:-}" ]] || exit 2
    run_model "$2"
    ;;
  __complete)
    [[ "${2:-}" == all || "${2:-}" == models || "${2:-}" == runnable || "${2:-}" == services || "${2:-}" == omp ]] || exit 2
    completion_models "$2"
    ;;
  help|-h|--help|'')
    usage
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
