kind() {
  case "$1" in
    deepseek-v4.1-flash-q2-32k) echo service ;;
    qwen3.8-27b|qwen3.8-27b-fixed-v22-4|qwen3.8-flash-next-iq4-xs|qwen3.8-flash-next-iq2-mtp|qwen3.8-27b-mlxfast-mtp-server|qwen3.6-35b-a3b|deepseek-v4-flash|glm-5.3-flash-q2|glm-5.3-flash-q2-131k|minimax-h3-standard|minimax-h3-heretic|muse-glimmer-30b-server)
      echo service
      ;;
    muse-glimmer-30b|qwen3.8-27b-mlxfast-mtp)
      echo harness
      ;;
    *)
      echo asset
      ;;
  esac
}

