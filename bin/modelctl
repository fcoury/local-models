models() {
  cat <<'EOF'
qwen3.8-27b
qwen3.8-27b-fixed-v22-4
qwen3.8-flash-next-iq4-xs
qwen3.8-flash-next-iq2-mtp
qwen3.8-27b-mlxfast-mtp
qwen3.8-27b-mlxfast-mtp-server
qwen3.6-35b-a3b
deepseek-v4.1-flash-q2-32k
deepseek-v4-flash
glm-5.3-flash-q2
glm-5.3-flash-q2-131k
minimax-h3-standard
minimax-h3-heretic
minimax-h3-comfy
minimax-h3-bf16
minimax-music3
mererun-ltx-2.3
mererun-qwen3-coder-next
mererun-gemma-3-12b
mererun-z-image-turbo
muse-glimmer-30b
muse-glimmer-30b-server
EOF
}

completion_models() {
  local scope="${1:-all}"
  local id
  local model_kind

  while IFS= read -r id; do
    model_kind="$(kind "$id")"
    case "$scope" in
      all|models)
        ;;
      runnable)
        [[ "$model_kind" == service || "$model_kind" == harness ]] || continue
        ;;
      services)
        [[ "$model_kind" == service ]] || continue
        ;;
      omp)
        [[ "$model_kind" == service ]] || continue
        omp_family "$id" >/dev/null 2>&1 || continue
        ;;
      *)
        return 2
        ;;
    esac
    printf '%s\t%s\n' "$id" "$(label "$id")"
  done < <(models)
}

