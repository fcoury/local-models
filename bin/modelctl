#!/usr/bin/env python3
"""Local model control: one front end over catalog-driven and legacy profiles.

Models in models.toml with a [models.launch] table are started from that data.
Every other profile is owned by modelctl-legacy, which this command calls.
"""
import sys

if sys.version_info < (3, 11):
    sys.exit('modelctl needs Python 3.11 or newer; found ' + sys.version.split()[0])

import concurrent.futures
import contextlib
import difflib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import tempfile
import time
import tomllib
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
LEGACY = ROOT / 'bin/modelctl-legacy'
CATALOG = Path(os.environ.get('MODELCTL_CATALOG', ROOT / 'models.toml'))
MODEL_HOME = Path(os.environ.get('MODEL_HOME', Path.home() / 'models'))
STATE = Path(os.environ.get('LOCAL_MODEL_STATE_HOME',
                            Path.home() / 'Library/Application Support/local-models'))
LOGS = STATE / 'logs'
CACHE = STATE / 'cache/modelctl.json'
READY_TTL = 6 * 3600
UNMANAGED_LIMIT_GIB = 8
HARNESSES = ('omp', 'pi')
GIB = 1024 ** 3

USAGE = '''\
Usage: modelctl [COMMAND] [MODEL] [OPTIONS]

See what's here
  (no command)            Show what is running
  list [--all]            Show models; --all adds assets and missing entries
  status [MODEL]          Show one model in detail, or what is running

Run a model
  start MODEL             Start a server in the background
  stop MODEL              Stop a server started by modelctl
  run MODEL [ARGS]        Run a server or interactive harness in the foreground
  logs MODEL              Follow a server log

Open a harness
  use HARNESS MODEL [ARGS]
                          Start the model if needed, then open omp or pi here.
                          A server that use started stops when the last session exits.
  omp MODEL [OMP_ARGS]    Run OMP with generated model metadata
  dsh MODEL [--prepare] [web|headless] [DSH_ARGS]
                          Run PTC against an already-running server; default: web

Inspect
  path MODEL              Print the canonical model path
  endpoint MODEL [--json] Print service endpoint metadata
  doctor [MODEL]          Verify all models, or one model and its runtime

Options
  --json                  Machine-readable output (list, status, endpoint)
  --refresh               Recheck installed files instead of using cached results (list)
  --quiet                 Hide progress (start, stop, use)
  --force                 Start even if an unmanaged server is using memory (start)
  NO_COLOR=1              Disable color

When piped, status keeps its original one-line-per-model format for scripts.
'''


class Failure(Exception):
    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


# ---- output -----------------------------------------------------------------

class Out:
    quiet = False

    @staticmethod
    def color(stream):
        return stream.isatty() and 'NO_COLOR' not in os.environ and os.environ.get('TERM') != 'dumb'


def paint(text, code, stream=None):
    return f'\033[{code}m{text}\033[0m' if Out.color(stream or sys.stdout) else text


def step(text, ok=True, stream=None):
    if Out.quiet and ok:
        return
    stream = stream or sys.stderr
    print(paint('✓' if ok else '!', '32' if ok else '33', stream), text, file=stream, flush=True)


@contextlib.contextmanager
def spinner(text, log=None):
    """Yield a tick() that redraws elapsed time on a terminal and stays quiet elsewhere."""
    started = time.monotonic()
    live = sys.stderr.isatty() and not Out.quiet
    frames = '⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    count = 0
    if not live and not Out.quiet:
        print(f'{text}…', file=sys.stderr, flush=True)

    def tick():
        nonlocal count
        if live:
            hint = f'  log: {short_path(log)}' if log else ''
            line = f'{frames[count % len(frames)]} {text}… {elapsed(time.monotonic() - started)}{hint}'
            width = shutil.get_terminal_size().columns - 1
            sys.stderr.write('\r\033[K' + line[:width])
            sys.stderr.flush()
            count += 1
    try:
        yield tick
    finally:
        if live:
            sys.stderr.write('\r\033[K')
            sys.stderr.flush()


def elapsed(seconds):
    seconds = int(seconds)
    if seconds < 3600:
        return f'{seconds // 60}:{seconds % 60:02d}'
    if seconds < 86400:
        return f'{seconds // 3600}h {seconds % 3600 // 60:02d}m'
    return f'{seconds // 86400}d {seconds % 86400 // 3600}h'


def short_path(path):
    text = str(path)
    home = str(Path.home())
    return '~' + text[len(home):] if text.startswith(home) else text


def size_text(count):
    return f'{count / GIB:.0f} G' if count and count >= GIB else (f'{count / 1024 ** 2:.0f} M' if count else '-')


def context_text(count):
    return f'{count // 1024}K' if count else '-'


def table(rows, header, fit=(), right=()):
    """Aligned columns that fit a terminal; `right` columns align right.

    `fit` lists (column, least) steps tried in order while a line is too wide:
    shrink the column to `least` characters, or drop it when `least` is None.
    """
    widths = [max(len(str(r[i])) for r in [header, *rows]) for i in range(len(header))]
    keep = list(range(len(header)))
    if sys.stdout.isatty():
        room = shutil.get_terminal_size().columns
        for i, least in fit:
            over = sum(widths[k] for k in keep) + 2 * (len(keep) - 1) - room
            if over <= 0:
                break
            if least is None:
                keep.remove(i)
            else:
                widths[i] = max(min(least, widths[i]), widths[i] - over)

    def line(row):
        cells = []
        for i in keep:
            text = str(row[i])
            if len(text) > widths[i]:
                text = text[:widths[i] - 1] + '…'
            cells.append(text.rjust(widths[i]) if i in right else text.ljust(widths[i]))
        return '  '.join(cells).rstrip()
    print(paint(line(header), '2'))
    return [line(row) for row in rows]


# ---- catalog ----------------------------------------------------------------

class Model:
    def __init__(self, entry, meta=None):
        self.entry = entry
        self.launch = entry.get('launch')
        self.data = self.launch is not None
        self.id = entry['id']
        self.alias = entry.get('alias')
        if self.data:
            self.label, self.kind = entry['name'], 'service'
            self.port, self.api = entry['port'], entry['api_model']
            self.context, self.output = entry['context'], entry['output']
            self.path = MODEL_HOME / entry['path']
        else:
            _, self.label, self.kind, port, self.api, context, output, path = meta
            self.port = int(port) if port else None
            self.context = int(context) if context else None
            self.output = int(output) if output else None
            self.path = Path(path)

    @property
    def name(self):
        return self.alias or self.id

    def supports(self, harness):
        return harness in self.entry.get('harness', {}).get('supported', [])

    @property
    def vision(self):
        # A legacy entry's vision field describes other clients; its harness table decides.
        return self.entry.get('harness', {}).get('vision', self.data and self.entry.get('vision'))

    @property
    def max_output(self):
        return self.entry.get('harness', {}).get('max_output', self.output)

    @property
    def service(self):
        return f'com.fcoury.local-models.{self.id.replace(".", "_")}'

    @property
    def log(self):
        return LOGS / f'{self.id}.log'

    @property
    def base_url(self):
        return f'http://127.0.0.1:{self.port}/v1'

    @property
    def runtime(self):
        name = re.split(r' [\d(]| with | Swift', self.entry.get('runner', '-'))[0]
        return {'DwarfStar': 'ds4', 'strands-decider MLX': 'mlx'}.get(name, name)

    @property
    def title(self):
        return re.sub(r' \([^)]*\)$', '', self.label)

    # Catalog-driven profiles only.
    @property
    def manifest(self):
        return json.loads((ROOT / self.entry['manifest']).read_text())

    @property
    def binary(self):
        return MODEL_HOME / self.entry['runtime_path']

    @property
    def receipt(self):
        return STATE / f'verification/{self.id}.json'

    def command(self):
        launch = self.launch
        if launch['engine'] != 'llama.cpp':
            raise Failure(f'{self.name} uses unsupported engine {launch["engine"]}.')
        command = [str(self.binary), '--model', str(self.path), '--alias', self.api,
                   '--host', '127.0.0.1', '--port', str(self.port),
                   '--ctx-size', str(self.context * launch['slots']),
                   '--parallel', str(launch['slots'])]
        if launch.get('mmproj'):
            command += ['--mmproj', str(MODEL_HOME / launch['mmproj'])]
        return command + launch['args']


def run_legacy(*args, **kwargs):
    return subprocess.run([str(LEGACY), *map(str, args)], **kwargs)


def exec_legacy(*args):
    sys.stdout.flush()
    sys.stderr.flush()
    os.execv(LEGACY, [str(LEGACY), *map(str, args)])


def signature(*paths):
    parts = []
    for path in paths:
        try:
            info = os.stat(path)
            parts.append(f'{info.st_mtime_ns}:{info.st_size}:{info.st_ino}')
        except OSError:
            parts.append('missing')
    return '|'.join(parts)


def load_cache():
    try:
        data = json.loads(CACHE.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=path.name)
    with os.fdopen(handle, 'w') as out:
        json.dump(data, out, indent=2)
        out.write('\n')
    os.replace(temporary, path)


def save_cache(cache):
    with contextlib.suppress(OSError):
        write_json(CACHE, cache)


class Catalog:
    def __init__(self):
        entries = {m['id']: m for m in tomllib.loads(CATALOG.read_text())['models']}
        self.cache = load_cache()
        key = f'{signature(LEGACY)}|{MODEL_HOME}'
        if self.cache.get('metadata_key') != key:
            result = run_legacy('__metadata', capture_output=True, text=True)
            if result.returncode:
                raise Failure('Could not read legacy profiles:\n' + result.stderr.strip())
            self.cache['metadata'] = [l.split('\t') for l in result.stdout.splitlines()]
            self.cache['metadata_key'] = key
            if sys.argv[1:2] not in (['__complete'], ['__names']):
                save_cache(self.cache)
        rows = self.cache['metadata']
        self.models = [Model(entries.get(r[0], {'id': r[0]}), r) for r in rows]
        self.models += [Model(e) for e in entries.values() if 'launch' in e]
        self.by_name = {}
        for model in self.models:
            for name in filter(None, (model.id, model.alias)):
                if name in self.by_name:
                    raise Failure(f'{CATALOG}: the name "{name}" is used twice.')
                self.by_name[name] = model

    def get(self, name):
        if name in self.by_name:
            return self.by_name[name]
        close = difflib.get_close_matches(name, self.by_name, n=3, cutoff=0.5)
        hint = f' Did you mean {" or ".join(close)}?' if close else ' See: modelctl list'
        raise Failure(f'Unknown model: {name}.{hint}', 2)

    def readiness(self, refresh=False):
        """Installed state and size per model, cached because legacy checks hash runtimes."""
        stored = self.cache.setdefault('ready', {})
        now = time.time()

        def check(model):
            key = (signature(CATALOG, model.path, model.binary, model.receipt) if model.data
                   else signature(LEGACY, model.path))
            old = stored.get(model.id)
            if not refresh and old and old['key'] == key and now - old['at'] < READY_TTL:
                return model.id, old
            return model.id, dict(key=key, at=now, ready=is_ready(model), size=disk_size(model))
        with concurrent.futures.ThreadPoolExecutor(8) as pool:
            fresh = dict(pool.map(check, self.models))
        if fresh != stored:
            self.cache['ready'] = fresh
            save_cache(self.cache)
        return fresh


def disk_size(model):
    if model.data:
        return sum(f['size'] for f in model.manifest['files'])
    if model.entry.get('bytes'):
        return model.entry['bytes']
    try:
        if model.path.is_file():
            return model.path.stat().st_size
        return sum(os.stat(os.path.join(base, f)).st_size
                   for base, _, files in os.walk(model.path) for f in files
                   if os.path.exists(os.path.join(base, f)))
    except OSError:
        return 0


# ---- verification -----------------------------------------------------------

def sha256(path):
    with open(path, 'rb') as handle:
        return hashlib.file_digest(handle, 'sha256').hexdigest()


def file_problems(model):
    """Cheap check: every pinned file is present at its pinned size and fully transferred."""
    problems = []
    for row in model.manifest['files']:
        path = model.path.parent / row['path']
        if not path.is_file():
            problems.append(f'missing {short_path(path)}')
        elif path.stat().st_size != row['size']:
            problems.append(f'wrong size {short_path(path)}')
        if path.with_name(path.name + '.aria2').exists():
            problems.append(f'incomplete transfer {short_path(path)}')
    if not os.access(model.binary, os.X_OK):
        problems.append(f'missing runtime {short_path(model.binary)}')
    return problems


def runtime_matches(model):
    """The runtime hash is cached against the file's identity, so a rebuild is always rehashed."""
    if not model.binary.is_file():
        return False
    path = STATE / 'cache/runtime.json'
    try:
        cache = json.loads(path.read_text())
    except (OSError, ValueError):
        cache = {}
    key = signature(model.binary)
    if cache.get(str(model.binary), [None])[0] != key:
        cache[str(model.binary)] = [key, sha256(model.binary)]
        with contextlib.suppress(OSError):
            write_json(path, cache)
    return cache[str(model.binary)][1] == model.entry['runtime_sha256']


def receipt_ok(model):
    """A receipt from doctor covers these exact files: same pins, unchanged since hashing."""
    try:
        receipt = json.loads(model.receipt.read_text())
    except (OSError, ValueError):
        return False
    expected = {f['path']: f['sha256'] for f in model.manifest['files']}
    return (receipt.get('revision') == model.manifest['revision']
            and receipt.get('sha256') == expected
            and receipt.get('signature') == {
                name: signature(model.path.parent / name) for name in expected})


def is_ready(model):
    if model.data:
        return not file_problems(model) and runtime_matches(model) and receipt_ok(model)
    return run_legacy('__ready', model.id, stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0


def verify(model):
    problems = file_problems(model)
    if problems:
        raise Failure(f'{model.name} is incomplete: ' + '; '.join(problems))
    if not runtime_matches(model):
        raise Failure(f'{model.name} runtime does not match its pinned SHA-256: {model.binary}')
    if not receipt_ok(model):
        raise Failure(f'{model.name} has not been verified since its files changed. '
                      f'Run: modelctl doctor {model.name}')


def doctor(model):
    problems = file_problems(model)
    if problems:
        raise Failure('\n'.join(problems))
    if not runtime_matches(model):
        raise Failure(f'runtime SHA-256 mismatch: {model.binary}')
    expected, signatures = {}, {}
    for row in model.manifest['files']:
        path = model.path.parent / row['path']
        before = signature(path)
        with spinner(f'Hashing {row["path"]}') as tick, \
                concurrent.futures.ThreadPoolExecutor(1) as pool:
            job = pool.submit(sha256, path)
            while not job.done():
                tick()
                time.sleep(0.1)
        if job.result() != row['sha256'] or signature(path) != before:
            model.receipt.unlink(missing_ok=True)
            raise Failure(f'SHA-256 mismatch: {path}')
        expected[row['path']], signatures[row['path']] = row['sha256'], before
    write_json(model.receipt, dict(id=model.id, revision=model.manifest['revision'],
                                   sha256=expected, signature=signatures,
                                   verified_at=time.strftime('%Y-%m-%dT%H:%M:%S%z')))
    print(f'ok      {model.id}: {len(expected)} files and runtime match their pinned SHA-256')


# ---- processes --------------------------------------------------------------

SERVER_PATTERN = re.compile(
    r'(?:^|/)(?:llama-server|ds4-server|mlx-serve|sushi|omlx|mlx_lm\.server|strata|rapid-mlx)(?=\s|$)')


def is_model_server(args):
    """Match the program itself, or the script an interpreter was given. Other
    arguments don't count, so an editor opening a file named sushi is not a server."""
    words = args.split()
    interpreter = bool(words) and re.fullmatch(r'python[\d.]*', os.path.basename(words[0]), re.I)
    return any(SERVER_PATTERN.search(w) for w in words[:3 if interpreter else 1])


class Processes:
    """One snapshot of launchd services and listening model servers."""

    def __init__(self):
        self.services = {}
        listing = subprocess.run(['launchctl', 'list'], capture_output=True, text=True).stdout
        for line in listing.splitlines():
            parts = line.split('\t')
            if len(parts) == 3 and parts[2].startswith('com.fcoury.local-models.'):
                self.services[parts[2]] = int(parts[0]) if parts[0].isdigit() else None
        self.ports = {}
        listing = subprocess.run(['lsof', '-nP', '-iTCP', '-sTCP:LISTEN', '-Fpn'],
                                 capture_output=True, text=True).stdout
        pid = None
        for line in listing.splitlines():
            if line.startswith('p'):
                pid = int(line[1:])
            elif line.startswith('n') and line.rsplit(':', 1)[-1].isdigit():
                self.ports.setdefault(int(line.rsplit(':', 1)[-1]), pid)

    def describe(self, pids):
        if not pids:
            return {}
        listing = subprocess.run(
            ['ps', '-o', 'pid=,ppid=,rss=,etime=,command=', '-p', ','.join(map(str, pids))],
            capture_output=True, text=True).stdout
        found = {}
        for line in listing.splitlines():
            pid, parent, rss, age, args = line.split(None, 4)
            found[int(pid)] = dict(parent=int(parent), rss=int(rss) * 1024, age=seconds(age), args=args)
        return found

    def unmanaged(self):
        """Listening model servers that no modelctl service started."""
        managed = {pid for pid in self.services.values() if pid}
        found = []
        details = self.describe(set(self.ports.values()))
        for port, pid in sorted(self.ports.items()):
            info = details.get(pid)
            if not info or pid in managed or info['parent'] in managed:
                continue
            if is_model_server(info['args']):
                name = re.search(r'(?:-hf|--model|-m|--alias)[ =](\S+)', info['args'])
                found.append(dict(pid=pid, port=port, rss=info['rss'], age=info['age'],
                                  command=os.path.basename(info['args'].split()[0]),
                                  model=os.path.basename(name[1]) if name else ''))
        return found


def seconds(age):
    days, _, clock = age.rpartition('-')
    total = 0
    for part in clock.split(':'):
        total = total * 60 + int(part)
    return total + int(days or 0) * 86400


def fetch(url):
    with urllib.request.urlopen(url, timeout=2) as reply:
        return json.load(reply)


def healthy(model):
    try:
        if fetch(f'http://127.0.0.1:{model.port}/health').get('status') != 'ok':
            return False
        return any(row.get('id') == model.api for row in fetch(model.base_url + '/models')['data'])
    except (OSError, ValueError, KeyError):
        return False


def legacy_state(model):
    words = run_legacy('status', model.id, capture_output=True, text=True).stdout.split()
    return words[1] if len(words) > 1 else 'unknown'


def state_of(model, processes, ready):
    if model.kind != 'service':
        if not ready:
            return 'missing'
        return 'managed' if model.id.startswith('mererun-') else 'ready'
    if model.service in processes.services:
        if not model.data:
            return legacy_state(model)
        if healthy(model):
            return 'running'
        return 'starting' if processes.services[model.service] else 'failed'
    if model.port in processes.ports:
        return 'external'
    if not ready and model.data and not file_problems(model):
        return 'unverified'
    return 'stopped' if ready else 'missing'


def active_services(catalog, processes):
    return [m for m in catalog.models
            if m.kind == 'service' and (m.service in processes.services or m.port in processes.ports)]


# ---- guardrails -------------------------------------------------------------

def sysctl(name):
    return int(subprocess.run(['/usr/sbin/sysctl', '-n', name],
                              capture_output=True, text=True).stdout.strip() or 0)


def gpu_limit_gib():
    limit = sysctl('iogpu.wired_limit_mb') / 1024
    # Without an explicit limit macOS allows roughly three quarters of memory.
    return limit or sysctl('hw.memsize') / GIB * 0.75


def check_memory(model):
    need, limit = model.launch['memory_gib'], gpu_limit_gib()
    if need > limit:
        raise Failure(f'{model.name} needs about {need} GiB but the GPU limit is {limit:.0f} GiB.')
    pressure = sysctl('kern.memorystatus_vm_pressure_level')
    if pressure >= 4:
        raise Failure('macOS reports critical memory pressure. Close something and try again.')
    if pressure >= 2:
        step('macOS reports elevated memory pressure', ok=False)
    step(f'Memory: needs about {need} GiB, GPU limit {limit:.0f} GiB')


def check_exclusive(model, catalog, processes, force=False):
    """Refuse a second large model. Legacy profiles also apply their own rules."""
    for other in active_services(catalog, processes):
        if other is not model and (model.data or other.data):
            raise Failure(f'{other.name} is already running. Stop it first: modelctl stop {other.name}'
                          if other.service in processes.services else
                          f'Something outside modelctl is using {other.name}\'s port {other.port}.')
    known = {m.port for m in catalog.models if m.port}
    for server in processes.unmanaged():
        if server['port'] in known:
            continue
        what = (f'{server["command"]} (PID {server["pid"]}, port {server["port"]}, '
                f'{server["rss"] / GIB:.0f} GiB)')
        if server['rss'] < UNMANAGED_LIMIT_GIB * GIB or force:
            step(f'Unmanaged server running: {what}', ok=False)
        else:
            raise Failure(f'An unmanaged server is holding memory: {what}. Stop it, or use '
                          f'modelctl start {model.name} --force')
    if model.data:
        step('No other large model running')


def check_directory():
    here = Path.cwd().resolve()
    with contextlib.suppress(OSError):
        home = MODEL_HOME.stat()
        for folder in (here, *here.parents):
            if os.path.samestat(folder.stat(), home):
                raise Failure(f'You are inside the model store ({short_path(here)}). '
                              'Open the harness from a project folder instead.')


@contextlib.contextmanager
def lock(name, shared=False, wait=True):
    folder = STATE / 'run'
    folder.mkdir(parents=True, exist_ok=True)
    with open(folder / name, 'a') as handle:
        flags = fcntl.LOCK_SH if shared else fcntl.LOCK_EX
        fcntl.flock(handle, flags if wait else flags | fcntl.LOCK_NB)
        yield


# ---- lifecycle --------------------------------------------------------------

def tail(path, start, lines=25):
    try:
        with open(path, 'rb') as handle:
            handle.seek(start)
            return '\n'.join(handle.read().decode(errors='replace').splitlines()[-lines:])
    except OSError:
        return ''


def remove_service(model):
    subprocess.run(['launchctl', 'remove', model.service], capture_output=True)
    limit = time.monotonic() + 30
    while time.monotonic() < limit:
        processes = Processes()
        if model.service not in processes.services and model.port not in processes.ports:
            return True
        time.sleep(0.3)
    return False


def start(model, catalog, force=False, output=None):
    """Start a service and return True, or return False if it was already running."""
    if model.kind != 'service':
        exec_legacy('start', model.id)
    with lock('start.lock'):
        processes = Processes()
        active = model.service in processes.services or model.port in processes.ports
        if not active:
            if model.data:
                verify(model)
                step(f'Files and runtime match pinned revision {model.manifest["revision"][:8]}')
                check_memory(model)
            check_exclusive(model, catalog, processes, force)
        if not model.data:
            return start_legacy(model, active, output)
        if active:
            if model.service not in processes.services:
                raise Failure(f'Something outside modelctl is using port {model.port}.')
            if healthy(model):
                return False
            if processes.services[model.service] is None:
                remove_service(model)
            else:
                step(f'{model.name} is already starting')
                await_ready(model, model.log.stat().st_size if model.log.exists() else 0)
                return False
        LOGS.mkdir(parents=True, exist_ok=True)
        offset = model.log.stat().st_size if model.log.exists() else 0
        began = time.monotonic()
        result = subprocess.run(
            ['launchctl', 'submit', '-l', model.service, '-o', str(model.log), '-e', str(model.log),
             '--', '/usr/bin/env', f'MODEL_HOME={MODEL_HOME}', f'LOCAL_MODEL_STATE_HOME={STATE}',
             f'MODELCTL_CATALOG={CATALOG}', f'PATH={os.environ["PATH"]}',
             sys.executable, str(ROOT / 'bin/modelctl'), '__run', model.id],
            capture_output=True, text=True)
        if result.returncode:
            raise Failure('launchctl could not start the service: ' + result.stderr.strip())
        await_ready(model, offset)
        step(f'Ready in {elapsed(time.monotonic() - began)} at {model.base_url}')
        return True


def await_ready(model, offset):
    """Wait for health. launchd restarts a failed job, so a lost or changed PID is a failure."""
    limit = time.monotonic() + model.launch.get('startup_timeout', 300)
    first, misses = None, 0
    try:
        with spinner(f'Loading {model.name}', model.log) as tick:
            while time.monotonic() < limit:
                for _ in range(10):
                    tick()
                    time.sleep(0.1)
                if healthy(model):
                    return
                listing = subprocess.run(['launchctl', 'list', model.service],
                                         capture_output=True, text=True)
                found = re.search(r'"PID" = (\d+);', listing.stdout)
                pid = found and int(found[1])
                first = first or pid
                misses = 0 if pid else misses + 1
                if listing.returncode or misses >= 5 or (pid and pid != first) or (first and not pid):
                    raise Failure(f'{model.name} exited during startup. Recent log:\n'
                                  + tail(model.log, offset) + f'\n\nFull log: {model.log}')
        raise Failure(f'{model.name} did not become ready in time. Recent log:\n'
                      + tail(model.log, offset) + f'\n\nFull log: {model.log}')
    except BaseException:
        remove_service(model)
        raise


def start_legacy(model, active, output=None):
    if active:
        # Legacy start only reports an existing listener, so leave it to the caller.
        if output is None and (code := run_legacy('start', model.id).returncode):
            raise Failure('', code)
        return False
    if not sys.stderr.isatty() or Out.quiet:
        try:
            result = run_legacy('start', model.id, stdout=output)
        except BaseException:
            remove_service(model)
            raise
        if result.returncode:
            raise Failure('', result.returncode)
        return True
    with tempfile.TemporaryFile('w+') as captured:
        job = subprocess.Popen([str(LEGACY), 'start', model.id], stdout=captured, stderr=captured)
        try:
            with spinner(f'Loading {model.name}', model.log) as tick:
                while job.poll() is None:
                    tick()
                    time.sleep(0.1)
        except BaseException:
            job.terminate()
            job.wait()
            remove_service(model)
            raise
        captured.seek(0)
        text = captured.read().strip()
    if job.returncode:
        raise Failure(text, job.returncode)
    step(text.splitlines()[0] if text else f'Started {model.name}')
    return True


def marker(model):
    return STATE / f'run/{model.id}.owned'


def stop(model, output=None):
    marker(model).unlink(missing_ok=True)
    if not model.data:
        result = run_legacy('stop', model.id, stdout=output)
        if result.returncode:
            raise Failure('', result.returncode)
        return
    processes = Processes()
    if model.service not in processes.services:
        if model.port in processes.ports:
            raise Failure(f'{model.name}\'s port {model.port} is used by a process outside modelctl; '
                          'refusing to stop it.')
        print(f'{model.name} is not running.')
        return
    with spinner(f'Stopping {model.name}') as tick:
        tick()
        done = remove_service(model)
    if not done:
        raise Failure(f'{model.name} did not stop after 30 seconds.')
    print(f'Stopped {model.name}.')


# ---- harnesses --------------------------------------------------------------

def link_shared(source, target, names):
    """Carry over the user's own extensions and instructions without copying them."""
    for name in names:
        here, there = target / name, source / name
        if there.exists() and not here.exists() and not here.is_symlink():
            here.symlink_to(there)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def prepare_omp(model):
    home = STATE / f'harness/omp/{model.id}'
    home.mkdir(parents=True, exist_ok=True)
    settings = model.entry['harness']
    provider = f'modelctl-{model.name.replace(".", "-")}'
    # YAML accepts JSON. thinkingFormat and reasoningDisableMode make every level,
    # including off, reach llama.cpp and mlx-serve as a per-request reasoning_effort.
    write_json(home / 'models.yml', {'providers': {provider: {
        'baseUrl': model.base_url, 'auth': 'none', 'api': 'openai-completions',
        'models': [{
            'id': model.api, 'name': model.label, 'reasoning': True,
            'thinking': {'mode': 'effort', 'efforts': settings['thinking'],
                         'defaultLevel': settings['thinking_default']},
            'input': ['text', 'image'] if model.vision else ['text'],
            'supportsTools': True, 'contextWindow': model.context, 'maxTokens': model.max_output,
            'cost': {'input': 0, 'output': 0, 'cacheRead': 0, 'cacheWrite': 0},
            'compat': {'supportsDeveloperRole': False, 'supportsReasoningEffort': True,
                       'thinkingFormat': 'openai', 'reasoningDisableMode': 'none-effort'},
        }]}}})
    config = home / 'config.yml'
    if not config.exists():
        config.write_text('setupVersion: 3\ncompaction:\n'
                          f'  keepRecentTokens: {settings["keep_recent_tokens"]}\n'
                          f'  reserveTokens: {settings["reserve_tokens"]}\n')
    link_shared(Path.home() / '.omp/agent', home, ('extensions', 'skills', 'prompts', 'AGENTS.md'))
    return home, ['omp', '--model', f'{provider}/{model.api}'], settings['thinking_default']


def prepare_pi(model):
    home = STATE / f'harness/pi/{model.id}'
    home.mkdir(parents=True, exist_ok=True)
    settings = model.entry['harness']
    levels = {level: level if level in settings['thinking'] else None
              for level in ('minimal', 'low', 'medium', 'high', 'xhigh', 'max')}
    write_json(home / 'models.json', {'providers': {'modelctl': {
        'baseUrl': model.base_url, 'api': 'openai-completions', 'apiKey': 'local',
        'compat': {'supportsDeveloperRole': False, 'supportsReasoningEffort': True},
        'models': [{
            'id': model.api, 'name': model.label, 'reasoning': True,
            'input': ['text', 'image'] if model.vision else ['text'],
            'contextWindow': model.context, 'maxTokens': model.max_output,
            'thinkingLevelMap': {'off': 'none', **levels},
            'cost': {'input': 0, 'output': 0, 'cacheRead': 0, 'cacheWrite': 0}}]}}})
    path = home / 'settings.json'
    shared = read_json(Path.home() / '.pi/agent/settings.json')
    config = read_json(path) or {k: shared[k] for k in ('theme', 'quietStartup') if k in shared}
    config.update(defaultProvider='modelctl', defaultModel=model.api)
    config.setdefault('defaultThinkingLevel', settings['thinking_default'])
    config.setdefault('compaction', {'enabled': True, 'reserveTokens': settings['reserve_tokens'],
                                     'keepRecentTokens': settings['keep_recent_tokens']})
    write_json(path, config)
    link_shared(Path.home() / '.pi/agent', home, ('extensions', 'skills', 'prompts', 'themes', 'AGENTS.md'))
    return home, ['pi', '--provider', 'modelctl', '--model', model.api], settings['thinking_default']


def run_harness(command, env):
    """Run in the foreground. The harness handles Ctrl-C; we stay to clean up after it."""
    child = None

    def forward(number, _):
        if child:
            with contextlib.suppress(OSError):
                child.send_signal(number)
    previous = {n: signal.signal(n, forward) for n in (signal.SIGTERM, signal.SIGHUP)}
    previous[signal.SIGINT] = signal.signal(signal.SIGINT, lambda *_: None)
    try:
        child = subprocess.Popen(command, env=env)
        code = child.wait()
        return code if code >= 0 else 128 - code
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


def use(harness, model, args, catalog):
    if harness not in HARNESSES:
        raise Failure(f'Unknown harness: {harness}. Choose {" or ".join(HARNESSES)}.', 2)
    check_directory()
    if not model.supports(harness) and not model.data:
        supported = run_legacy('__complete', 'omp', capture_output=True, text=True).stdout
        if harness != 'omp' or model.id not in [l.split('\t')[0] for l in supported.splitlines()]:
            ready = [m.name for m in catalog.models if m.supports(harness)]
            raise Failure(f'{model.name} is not set up for {harness} yet. '
                          f'Set up for {harness}: {", ".join(ready)}', 2)
        home = STATE / f'harness/omp/{model.id}'
        home.mkdir(parents=True, exist_ok=True)
        shared = STATE / 'omp-agent/config.yml'
        if shared.exists() and not (home / 'config.yml').exists():
            shutil.copyfile(shared, home / 'config.yml')
        link_shared(Path.home() / '.omp/agent', home, ('extensions', 'skills', 'prompts', 'AGENTS.md'))
        guard_legacy(model, catalog)
        os.environ['MODELCTL_OMP_AGENT_DIR'] = str(home)
        exec_legacy('omp', model.id, *args)
    if not model.supports(harness):
        raise Failure(f'{model.name} is not set up for {harness} yet.', 2)
    if not shutil.which(harness):
        raise Failure(f'{harness} is not installed.')
    home, command, level = {'omp': prepare_omp, 'pi': prepare_pi}[harness](model)
    if not any(a == '--thinking' or a.startswith('--thinking=') for a in args):
        command += ['--thinking', level]
    # Sessions share this lock; the last one out stops a server that use started.
    owned = False
    try:
        with lock(f'{model.id}.lock', shared=True):
            # Harness output may be piped, so startup messages go to stderr.
            if start(model, catalog, output=sys.stderr):
                marker(model).write_text('started by modelctl use\n')
            if not model.data and (state := legacy_state(model)) != 'running':
                raise Failure(f'{model.name} is {state}, not ready. See: modelctl logs {model.name}')
            code = run_harness(command + args, dict(os.environ, PI_CODING_AGENT_DIR=str(home)))
    finally:
        owned = marker(model).exists()
        if owned:
            with contextlib.suppress(BlockingIOError), lock(f'{model.id}.lock', wait=False):
                if marker(model).exists():
                    Out.quiet = True
                    with contextlib.redirect_stdout(sys.stderr):
                        stop(model, sys.stderr)
    return code


def guard_legacy(model, catalog, force=False):
    processes = Processes()
    if model.kind == 'service' and model.service not in processes.services \
            and model.port not in processes.ports:
        check_exclusive(model, catalog, processes, force)


# ---- views ------------------------------------------------------------------

DOT = {'running': ('●', '32'), 'starting': ('◐', '33'), 'failed': ('✗', '31'),
       'external': ('●', '33'), 'unverified': ('!', '33'), 'missing': ('-', '2')}


def decorate(line, state):
    mark, code = DOT.get(state, ('', ''))
    return line.replace(f'{mark} {state}', paint(f'{mark} {state}', code)) if mark else line


def state_text(state):
    mark = DOT.get(state, ('',))[0]
    return f'{mark} {state}' if mark else state


def running_rows(catalog, processes):
    rows = []
    active = active_services(catalog, processes)
    details = processes.describe(
        {processes.services.get(m.service) or processes.ports.get(m.port) for m in active} - {None})
    for model in active:
        pid = processes.services.get(model.service) or processes.ports.get(model.port)
        info = details.get(pid, {})
        rows.append(dict(name=model.name, id=model.id, label=model.label, port=model.port, pid=pid,
                         state=state_of(model, processes, True), context=model.context,
                         slots=(model.launch or {}).get('slots', 1),
                         rss=info.get('rss'), uptime=info.get('age'), endpoint=model.base_url))
    return rows


def show_running(as_json):
    catalog, processes = Catalog(), Processes()
    rows = running_rows(catalog, processes)
    taken = {r['port'] for r in rows}
    unmanaged = [s for s in processes.unmanaged() if s['port'] not in taken]
    if as_json:
        print(json.dumps(dict(running=rows, unmanaged=unmanaged), indent=2))
        return
    if rows:
        print(paint('RUNNING', '1'))
        cells = [[r['name'], r['label'], state_text(r['state']), f':{r["port"]}',
                  (f'{r["slots"]} × ' if r['slots'] > 1 else '') + context_text(r['context']),
                  f'{r["rss"] / GIB:.0f} GiB' if r['rss'] else '-',
                  elapsed(r['uptime']) if r['uptime'] is not None else '-'] for r in rows]
        for row, line in zip(rows, table(
                cells, ['NAME', 'MODEL', 'STATE', 'PORT', 'CONTEXT', 'MEMORY', 'UPTIME'],
                fit=[(1, 12), (1, None), (3, None), (0, 16)], right={4, 5})):
            print(decorate(line, row['state']))
    else:
        print('No models running.')
    if unmanaged:
        print('\n' + paint('NOT MANAGED BY MODELCTL', '1'))
        for s in unmanaged:
            print(f'{s["command"]}  {s["model"]}  :{s["port"]}  PID {s["pid"]}  '
                  f'{s["rss"] / GIB:.0f} GiB  {elapsed(s["age"])}')
    if rows:
        name, pick = rows[0]['name'], catalog.by_name[rows[0]['id']]
        offers = [h for h in HARNESSES if pick.supports(h)]
        hints = [f'modelctl use {offers[0]} {name}'] if offers else []
        print('\nNext: ' + ' · '.join(hints + [f'modelctl logs {name}', f'modelctl stop {name}']))
    else:
        print('\nNext: modelctl list · modelctl start NAME')


def show_list(show_all, as_json, refresh):
    catalog, processes = Catalog(), Processes()
    ready = catalog.readiness(refresh)
    rows = []
    for model in catalog.models:
        state = state_of(model, processes, ready[model.id]['ready'])
        rows.append(dict(name=model.name, id=model.id, alias=model.alias, label=model.label,
                         title=model.title, kind=model.kind, runtime=model.runtime, port=model.port,
                         context=model.context, output=model.output, size=ready[model.id]['size'],
                         state=state, status=model.entry.get('status'), path=str(model.path)))
    if as_json:
        print(json.dumps(rows, indent=2))
        return
    order = {'running': 0, 'external': 0, 'starting': 0, 'failed': 0}
    shown = [r for r in rows if show_all or
             (r['kind'] != 'asset' and r['state'] != 'missing')]
    shown.sort(key=lambda r: (order.get(r['state'], 1), not r['alias']))
    cells = [[r['name'], r['title'], r['runtime'], context_text(r['context']),
              size_text(r['size']), state_text(r['state'])] for r in shown]
    for row, line in zip(shown, table(
            cells, ['NAME', 'MODEL', 'RUNTIME', 'CTX', 'SIZE', 'STATE'],
            fit=[(1, 12), (2, 10), (1, None), (2, None), (0, 16)], right={3, 4})):
        print(decorate(line, row['state']))
    hidden = len(rows) - len(shown)
    if hidden:
        assets = sum(r['kind'] == 'asset' for r in rows)
        parts = [f'{assets} assets'] if assets else []
        parts += [f'{hidden - assets} missing'] if hidden > assets else []
        print(f'\n{" and ".join(parts)} hidden · modelctl list --all')


def legacy_status_line(model, processes):
    """The original columns: scripts read the first two."""
    ready = is_ready(model)
    state = state_of(model, processes, ready)
    if model.service in processes.services:
        detail = f'pid={processes.services[model.service] or "unknown"} port={model.port}'
    elif state == 'external':
        detail = f'port={model.port} (not managed by modelctl)'
    elif state == 'stopped':
        detail = f'port={model.port}'
    else:
        detail = str(model.path)
    return f'{model.id:<29} {state:<9} {detail}'


def show_status(name, as_json):
    plain = not sys.stdout.isatty() and not as_json
    if name is None:
        if not plain:
            show_running(as_json)
            return
        result = run_legacy('status')
        sys.stdout.flush()
        processes = Processes()
        for model in Catalog().models:
            if model.data:
                print(legacy_status_line(model, processes))
        if result.returncode:
            raise Failure('', result.returncode)
        return
    catalog = Catalog()
    model = catalog.get(name)
    if plain and not model.data:
        exec_legacy('status', model.id)
    processes = Processes()
    if plain:
        print(legacy_status_line(model, processes))
        return
    ready = is_ready(model)
    state = state_of(model, processes, ready)
    running = [r for r in running_rows(catalog, processes) if r['id'] == model.id]
    live = running[0] if running else {}
    info = dict(name=model.name, id=model.id, label=model.label, state=state,
                status=model.entry.get('status'), runtime=model.entry.get('runner'),
                context=model.context, slots=(model.launch or {}).get('slots', 1),
                output=model.output, endpoint=model.base_url if model.port else None,
                pid=live.get('pid'), rss=live.get('rss'), uptime=live.get('uptime'),
                path=str(model.path), log=str(model.log) if model.kind == 'service' else None,
                source=model.entry.get('source'), revision=model.entry.get('source_revision'),
                harnesses=model.entry.get('harness', {}).get('supported', []),
                notes=model.entry.get('notes'))
    if as_json:
        print(json.dumps(info, indent=2))
        return
    print(paint(model.name, '1') + f'  {model.label}')
    context = context_text(model.context) if model.context else None
    if context and info['slots'] > 1:
        context = f'{info["slots"]} × {context}'
    lines = [('State', decorate(state_text(state), state)), ('ID', model.id),
             ('Catalog', info['status']), ('Runtime', info['runtime']), ('Context', context),
             ('Memory', f'{live["rss"] / GIB:.0f} GiB' if live.get('rss') else None),
             ('Uptime', elapsed(live['uptime']) if live.get('uptime') is not None else None),
             ('Endpoint', info['endpoint']), ('Harnesses', ', '.join(info['harnesses'])),
             ('Source', ' @ '.join(filter(None, [info['source'], (info['revision'] or '')[:8]]))),
             ('Path', short_path(model.path)), ('Log', short_path(model.log) if info['log'] else None),
             ('Notes', info['notes'])]
    for key, value in lines:
        if value:
            print(f'  {paint(key.ljust(10), "2")} {value}')


# ---- commands ---------------------------------------------------------------

def take(args, *flags):
    """Remove known flags from args and report which were present."""
    found = {flag: flag in args for flag in flags}
    args[:] = [a for a in args if a not in flags]
    return found


def no_extra(args):
    if args:
        raise Failure(f'Unexpected argument: {args[0]}', 2)


def need(args, what='a model'):
    if not args:
        raise Failure(f'Name {what}. See: modelctl help', 2)
    return args.pop(0)


def complete(scope, aliases):
    output = ''
    if scope != 'pi':
        result = run_legacy('__complete', scope, capture_output=True, text=True)
        if result.returncode:
            return result.returncode
        output = result.stdout
    sys.stdout.write(output)
    shown = {line.split('\t')[0] for line in output.splitlines()}
    for model in Catalog().models:
        if model.id not in shown and (model.supports(scope) if scope in HARNESSES else model.data):
            print(f'{model.id}\t{model.label}')
            shown.add(model.id)
        if aliases and model.alias and model.id in shown:
            print(f'{model.alias}\t{model.label}')
    return 0


def main(argv):
    command, args = (argv[0] if argv else ''), list(argv[1:])
    if command in ('help', '-h', '--help'):
        print(USAGE, end='')
        return 0
    if command in ('', '--json'):
        show_running(command == '--json')
        return 0
    if command in ('__complete', '__names'):
        if len(args) != 1:
            return 2
        return complete(args[0], command == '__names')
    if command in ('__metadata', '__ready'):
        exec_legacy(command, *args)

    if command == 'list':
        flags = take(args, '--all', '--json', '--refresh')
        no_extra(args)
        show_list(flags['--all'], flags['--json'], flags['--refresh'])
        return 0
    if command == 'status':
        flags = take(args, '--json')
        name = args.pop(0) if args else None
        no_extra(args)
        show_status(name, flags['--json'])
        return 0
    if command in ('start', 'stop'):
        flags = take(args, '--quiet', *(['--force'] if command == 'start' else []))
        Out.quiet = flags['--quiet']
        catalog = Catalog()
        model = catalog.get(need(args))
        no_extra(args)
        if command == 'stop':
            if model.kind != 'service':
                raise Failure(f'{model.name} is not a model server.', 2)
            stop(model)
            return 0
        started = start(model, catalog, flags['--force'])
        # An explicit start means keep it running after use sessions end.
        marker(model).unlink(missing_ok=True)
        if model.data and not Out.quiet and not (started and sys.stdout.isatty()):
            print(f'{model.name} is {"running" if started else "already running"} at {model.base_url}')
        return 0
    if command == 'use':
        Out.quiet = bool(args and args[0] == '--quiet' and args.pop(0))
        harness = need(args, 'a harness and a model')
        if harness not in HARNESSES:
            raise Failure(f'Unknown harness: {harness}. Choose {" or ".join(HARNESSES)}.', 2)
        catalog = Catalog()
        return use(harness, catalog.get(need(args)), args, catalog)

    if command in ('run', 'logs', 'path', 'endpoint', 'omp', 'dsh', '__run'):
        catalog = Catalog()
        model = catalog.get(need(args))
        if command == 'omp' and model.supports('omp'):
            return use('omp', model, args, catalog)
        if not model.data:
            if command == 'omp':
                check_directory()
            if command in ('run', 'omp'):
                guard_legacy(model, catalog)
            exec_legacy(command, model.id, *args)
        if command == 'run':
            processes = Processes()
            if model.service in processes.services or model.port in processes.ports:
                raise Failure(f'{model.name} is already running.')
            verify(model)
            check_memory(model)
            check_exclusive(model, catalog, processes)
            line = model.command() + args
            os.execv(line[0], line)
        if command == '__run':
            verify(model)
            line = model.command()
            os.execv(line[0], line)
        if command == 'logs':
            LOGS.mkdir(parents=True, exist_ok=True)
            model.log.touch()
            os.execvp('tail', ['tail', '-f', str(model.log)])
        if command == 'path':
            print(model.path)
        elif command == 'endpoint':
            flags = take(args, '--json')
            no_extra(args)
            print(json.dumps(dict(id=model.id, base_url=model.base_url, api_model=model.api,
                                  context=model.context, output=model.output), indent=2)
                  if flags['--json'] else model.base_url)
        elif command == 'dsh':
            raise Failure(f'{model.name} is not set up for dsh yet.', 2)
        return 0
    if command == 'doctor':
        catalog = Catalog()
        if args:
            model = catalog.get(args[0])
            if model.data:
                doctor(model)
                return 0
            exec_legacy('doctor', model.id)
        code = run_legacy('doctor').returncode
        for model in catalog.models:
            if model.data:
                if is_ready(model):
                    print(f'ok      {model.id}')
                else:
                    print(f'missing {model.id}: run modelctl doctor {model.name}')
                    code = code or 1
        return code
    raise Failure(f'Unknown command: {command}\n\n{USAGE}', 2)


def leave(number, _):
    sys.exit(128 + number)


if __name__ == '__main__':
    for number in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, leave)
    try:
        sys.exit(main(sys.argv[1:]))
    except Failure as error:
        if str(error):
            print(paint('✗', '31', sys.stderr), error, file=sys.stderr)
        sys.exit(error.code)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(141)
